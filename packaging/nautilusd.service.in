[Unit]
Description=Nautilus Container Runtime
After=network.target
Wants=network.target

[Service]
Type=exec
ExecStart=@BINDIR@/nautilusd --config @CONFDIR@/config.toml
KillMode=process
Restart=on-failure
RestartSec=5
Delegate=yes
LimitNOFILE=1048576
TasksMax=infinity

[Install]
WantedBy=multi-user.target
